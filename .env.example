# Shared artifact location. Do not commit .env or any real data/model artifact.
KEIBA_DATA_DIR=
KEIBA_MODEL_DIR=
KEIBA_DB_PATH=
KEIBA_REGISTRY_DB_PATH=
KEIBA_FAILED_LOG_PATH=
KEIBA_PRODUCTION_VERSION_PATH=

# Oracle Cloud VM 設定例（block volume を /data/keiba-ai にマウントした場合）:
# KEIBA_DATA_DIR=/data/keiba-ai
# KEIBA_DB_PATH=/data/keiba-ai/keiba.db
# KEIBA_REGISTRY_DB_PATH=/data/keiba-ai/research_registry.db
# KEIBA_MODEL_DIR=/data/keiba-ai/models
# KEIBA_FAILED_LOG_PATH=/data/keiba-ai/failed_races.jsonl
# KEIBA_PRODUCTION_VERSION_PATH=/data/keiba-ai/models/production_version.txt
#
# production_version.txt の使い方:
#   echo "v202609" > /data/keiba-ai/models/production_version.txt
#   # → 次のAPIリクエストから keiba_lgbm_v202609.pkl を使用
#   # ロールバック: echo "v202608" > /data/keiba-ai/models/production_version.txt
